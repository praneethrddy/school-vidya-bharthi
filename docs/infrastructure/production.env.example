# Database
DATABASE_URL=postgresql://schoolos_app:replace-with-db-password@127.0.0.1:5432/schoolos
DIRECT_URL=postgresql://schoolos_app:replace-with-db-password@127.0.0.1:5432/schoolos

# Redis
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379

# Auth
NEXTAUTH_URL=https://school.example.com
AUTH_URL=https://school.example.com
NEXTAUTH_SECRET=replace-with-strong-random-value
AUTH_SECRET=replace-with-the-same-strong-random-value

# Cron and webhooks
CRON_SHARED_SECRET=replace-with-strong-random-value
WEBHOOK_SECRET=replace-with-strong-random-value

# Field encryption
FIELD_ENCRYPTION_KEY=k1.aesgcm256.replace-with-generated-key

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-account-id
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-access-key
R2_SECRET_ACCESS_KEY=replace-with-secret-key
R2_BUCKET_NAME=replace-with-bucket-name
R2_PUBLIC_URL=https://replace-with-public-base-url

# Email
RESEND_API_KEY=replace-with-api-key
RESEND_FROM_EMAIL=noreply@school.example.com

# Monitoring
SENTRY_DSN=replace-with-sentry-dsn
LOG_LEVEL=info
NODE_ENV=production

# Public platform settings
NEXT_PUBLIC_APP_URL=https://school.example.com
NEXT_PUBLIC_PLATFORM_ROOT_URL=https://school.example.com
NEXT_PUBLIC_PLATFORM_DOMAIN=school.example.com
NEXT_PUBLIC_SCHOOL_NAME=Vidhya Bharthi High School
PUBLIC_DEFAULT_SCHOOL_SLUG=vbhs
PUBLIC_CONTACT_EMAIL=office@school.example.com

# Optional Cloudflare domain automation
CLOUDFLARE_API_TOKEN=replace-if-using-cloudflare-custom-domain-automation
CLOUDFLARE_ZONE_ID=replace-if-using-cloudflare-custom-domain-automation
